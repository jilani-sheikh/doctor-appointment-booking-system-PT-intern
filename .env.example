# Neon PostgreSQL connection string (serverless HTTP driver)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require"

# Auth.js secret key (generate with `openssl rand -base64 33` or `npx auth secret`)
AUTH_SECRET="your-auth-secret-min-32-chars"

# Google Cloud OAuth Credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional in production (Vercel automatically sets this; set only if using custom domain)
# AUTH_URL="https://your-domain.vercel.app"
