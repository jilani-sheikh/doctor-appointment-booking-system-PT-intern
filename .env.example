# Neon PostgreSQL connection string (POOLED - used at runtime by @prisma/adapter-neon)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[database]?sslmode=require"

# Neon PostgreSQL connection string (DIRECT / non-pooled - used exclusively by Prisma CLI for migrations)
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[database]?sslmode=require"

# Auth.js secret key (generate with `openssl rand -base64 33` or `npx auth secret`)
AUTH_SECRET="your-auth-secret-min-32-chars"

# Google Cloud OAuth Credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional in production (Vercel automatically sets this; set only if using custom domain)
# AUTH_URL="https://your-domain.vercel.app"

# Optional Admin emails (comma-separated, auto-promoted ONLY on verified Google Sign-In)
# ADMIN_EMAILS="admin@example.com,admin2@example.com"

# Public application base URL (used to generate return and notify URLs on server; trailing slashes are stripped)
# Local: http://localhost:3000
# Tunnel (ngrok/localtunnel): https://<your-tunnel-subdomain>.ngrok-free.app
# Production: https://doctorappointmentbookingsystem-pi.vercel.app
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Mode: "disabled" (default, free auto-confirmed bookings) | "cashfree" (online payment required)
PAYMENTS_MODE="disabled"

# Cashfree Payment Gateway Credentials
# Accepted names: CASHFREE_KEY_ID (fallback: CASHFREE_APP_ID), CASHFREE_SECRET (fallback: CASHFREE_SECRET_KEY)
CASHFREE_KEY_ID="your-cashfree-app-id"
CASHFREE_SECRET="your-cashfree-secret-key"
CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2023-08-01"

# Resend Email Service Credentials
# Accepted sender names: RESEND_FROM_EMAIL (fallback: EMAIL_FROM, default: onboarding@resend.dev)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Cron Secret for /api/cron/tick (generate with [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N"))
CRON_SECRET="your-secure-random-cron-secret-32-chars"

# Comma-separated reminder notification offsets before slot startTime in minutes (default: 24h and 2h)
REMINDER_OFFSETS_MINUTES="1440,120"